# AjaTrade environment variables
#
# 1. Copy this file to a new file named .env (same folder as main.py)
# 2. Fill in your own values
# 3. NEVER commit .env to GitHub (it is already in .gitignore)
#
# Lines marked REQUIRED must be filled for the bot to start and reply.

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)  -- REQUIRED
# Get these at https://developers.facebook.com -> your app -> WhatsApp -> API Setup
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=           # REQUIRED. "Temporary access token" (24 h) or a permanent System User token
WHATSAPP_PHONE_NUMBER_ID=        # REQUIRED. "Phone number ID" on the API Setup page (a number, not the phone number)
WHATSAPP_VERIFY_TOKEN=           # REQUIRED. Any word you make up; type the same word in Meta's webhook settings
WHATSAPP_APP_SECRET=             # App settings -> Basic -> App secret. Leave empty only for local testing
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Database  -- REQUIRED
# Local:   postgresql://postgres:yourpassword@localhost:5432/ajatrade
# Railway: copy DATABASE_URL from the Railway Postgres service
# After setting it, run once:  alembic upgrade head
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# N-ATLAS server  -- REQUIRED
# The URL printed by Kaggle (trycloudflare.com) or Modal (modal.run), no slash at the end.
# NATLAS_API_KEY is the same password you set as NATLAS_SERVER_KEY on the server.
# ---------------------------------------------------------------------------
NATLAS_BASE_URL=
NATLAS_API_KEY=
NATLAS_TIMEOUT_SECONDS=90        # use 240 if the server sleeps when idle (Modal with 0 containers)
NATLAS_ASR_URL=                  # optional: only if speech recognition runs on a different server
NATLAS_MODEL=NCAIR1/N-ATLaS

# ---------------------------------------------------------------------------
# Text-to-speech (Spitch)  -- REQUIRED for voice replies
# https://studio.spitch.app -> API keys. Without it the bot replies in text only.
# ---------------------------------------------------------------------------
SPITCH_API_KEY=

# ---------------------------------------------------------------------------
# Photo step (vision model on Groq)  -- REQUIRED for photo diagnosis, weeds,
# germination photos and soil-report photos
# https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=
VISION_MODEL_NAME=               # optional; default qwen/qwen3.8-27b

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
STT_FALLBACK=                    # set to "elevenlabs" only to fall back from N-ATLAS ASR in an emergency
ELEVENLABS_API_KEY=              # only needed with STT_FALLBACK=elevenlabs
EXPORT_SALT=                     # any random words; used to hide phone numbers in scripts/export_validation.py
